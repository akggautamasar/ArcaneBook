# ================================================
# AirBook – Environment Variables
# ================================================

# 1. Create a Telegram bot via @BotFather and paste the token here
VITE_TELEGRAM_BOT_TOKEN=7123456789:AAHxyz...

# 2. Create a private Telegram channel, add your bot as an ADMIN,
#    then paste the channel ID here (starts with -100 for channels)
VITE_TELEGRAM_CHANNEL_ID=-1001234567890

# 3. Optional: Change the master admin password (default: Air@2003)
# VITE_MASTER_PASSWORD=YourSecretPassword
